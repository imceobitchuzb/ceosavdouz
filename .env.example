# CEOSAVDOUZ Environment Configuration

# Database Connection (SQLite for zero-config local dev, or PostgreSQL for production)
# Local SQLite default:
DATABASE_URL="file:./dev.db"

# For Production PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/ceosavdouz?schema=public"

# Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET="ceosavdouz_jwt_super_secret_key_change_in_production_2026_xyz"

# Node Environment
NODE_ENV="development"

# App Public URL & WebApp URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WEBAPP_URL="https://your-domain.com" # or https://abc.ngrok-free.app for Telegram WebApp HTTPS requirement

# Telegram Bot Integration (aiogram 3)
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"
TELEGRAM_BOT_USERNAME="ceosavdouz_bot"
